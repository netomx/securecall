{
  "sourceLanguage": "es",
  "strings": {
    "%@ está en otra llamada": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is on another call"
          }
        }
      }
    },
    "1. Que %@ escanee este código con su Kalloq (Contactos → tu nombre → Verificar con QR).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Let %@ scan this code with their Kalloq (Contacts → your name → Verify with QR)."
          }
        }
      }
    },
    "2. Escanea el código en el teléfono de %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Scan the code on %@'s phone."
          }
        }
      }
    },
    "6–32 caracteres: a–z, 0–9, _ y . — solo tú lo ves": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "6–32 characters: a–z, 0–9, _ and . — only you see it"
          }
        }
      }
    },
