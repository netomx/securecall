      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unblock"
          }
        }
      }
    },
    "Dilo en voz alta: si coincide en los dos teléfonos, nadie está en medio.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say it out loud: if it matches on both phones, nobody is in the middle."
          }
        }
      }
    },
    "El código anterior deja de servir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous code stops working."
          }
        }
      }
    },
