<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist: INFOPLIST_KEY_ build settings cannot set background
	     modes. Without voip, PushKit never hands out a token and CallKit drops incoming calls. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>voip</string>
	</array>
	<!-- kalloq://add/<id>, the same scheme as Android; https://call.l8.nz/a/<id> comes through
	     Associated Domains (Kalloq.entitlements). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.cim.securecall</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kalloq</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
