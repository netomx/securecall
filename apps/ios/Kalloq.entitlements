<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push (VoIP through PushKit). "development" for Xcode builds; exporting for TestFlight or the
	     App Store turns it into "production". -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links: https://call.l8.nz/a/<id> opens the app (deploy/www/.well-known/apple-app-site-association). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:call.l8.nz</string>
	</array>
</dict>
</plist>
